#!/usr/bin/env bash
# One helper: ./llm <overlay> | stop | build [bee|bun|main] | download
# Default overlay files (qwen.yml, …) stay BeeLlama. *-bun.yml / *-main.yml
# are comparison engines and override the image.
set -euo pipefail
cd "$(dirname "$0")"

COMPOSE=(docker compose -f docker-compose.yml)
BEE_MODELS=(qwen qwen-uncensored superqwen cybertiel tiel genesis)

usage() {
    echo "usage: $0 <overlay> | stop | build [bee|bun|main] | download" >&2
    echo "  overlays: ${BEE_MODELS[*]}" >&2
    echo "            <model>-bun   (buun-llama-cpp, VBR KV)   image bun:native" >&2
    echo "            <model>-main  (llama.cpp master, q5_1)   image llamacpp:native" >&2
    echo "  build:    ./llm build          # BeeLlama → beellama:native" >&2
    echo "            ./llm build bun      # buun      → bun:native" >&2
    echo "            ./llm build main     # llama.cpp → llamacpp:native" >&2
    exit 1
}

overlay_files() {
    local f
    for f in *.yml; do
        [[ "$f" == docker-compose.yml ]] && continue
        printf '%s\n' "$f"
    done
}

overlay_names() {
    local f
    while IFS= read -r f; do
        printf '%s\n' "${f%.yml}"
    done < <(overlay_files)
}

container_names() {
    local f name
    while IFS= read -r f; do
        name=$(awk '/^[[:space:]]*container_name:/{print $2; exit}' "$f")
        [[ -n "$name" ]] && printf '%s\n' "$name"
    done < <(overlay_files)
    printf '%s\n' ornith llm-compare
}

down_all() {
    local y
    while IFS= read -r y; do
        "${COMPOSE[@]}" -f "$y" down --remove-orphans --timeout 20 >/dev/null 2>&1 || true
    done < <(overlay_files)
    # shellcheck disable=SC2046
    docker rm -f $(container_names) >/dev/null 2>&1 || true
}

up_model() {
    local yml="$1"
    echo "Stopping other models…"
    down_all
    "${COMPOSE[@]}" -f "$yml" up -d --wait --wait-timeout 240 --remove-orphans
    "${COMPOSE[@]}" -f "$yml" ps
    nvidia-smi --query-gpu=name,memory.used,memory.total,memory.free --format=csv
}

host_arch() {
    command -v nvidia-smi >/dev/null 2>&1 || {
        echo "nvidia-smi not found — NVIDIA driver required." >&2
        exit 1
    }
    local arch
    arch=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader \
           | tr -d ' .' | sort -u | paste -sd';' -)
    [[ -n "$arch" ]] || { echo "Could not read compute capability." >&2; exit 1; }
    printf '%s\n' "$arch"
}

do_build() {
    local target="${1:-bee}"
    local arch image file ref desc
    arch=$(host_arch)
    echo "GPU compute capability: ${arch}"
    case "$target" in
        bee|"")
            image=beellama:native
            file=Dockerfile
            ref=main
            desc="BeeLlama main"
            ;;
        bun)
            image=bun:native
            file=Dockerfile.bun
            ref=master
            desc="buun-llama-cpp master"
            ;;
        main)
            image=llamacpp:native
            file=Dockerfile.main
            ref=master
            desc="ggml-org/llama.cpp master"
            ;;
        *)
            echo "unknown build target: $target (want: bee | bun | main)" >&2
            exit 1
            ;;
    esac
    echo "Building ${image} from ${file} (CPU: -march=native, CUDA: sm_${arch//;/, sm_}, toolkit 13.3.1, ${desc})"
    docker build \
        -f "$file" \
        --build-arg CUDA_DOCKER_ARCH="${arch}" \
        --build-arg GGML_NATIVE=ON \
        --build-arg LLAMACPP_REF="$ref" \
        -t "$image" \
        .
}

parse_download() {
    python3 - "$1" <<'PY'
import re, sys
text = open(sys.argv[1]).read()
block = re.search(r"^x-download:\n((?:  .+\n)+)", text, re.M)
if not block:
    sys.exit(f"no x-download in {sys.argv[1]}")
kv = dict(re.findall(r"^\s+(\w+):\s+(\S+)", block.group(1), re.M))
for key in ("repo", "file", "sha256"):
    if key not in kv:
        sys.exit(f"x-download missing {key} in {sys.argv[1]}")
    print(kv[key])
PY
}

check_one() {
    local yml="$1"
    local repo file expected
    repo=$(parse_download "$yml" | sed -n '1p')
    file=$(parse_download "$yml" | sed -n '2p')
    expected=$(parse_download "$yml" | sed -n '3p')
    local path="models/$file"

    echo
    echo "== ${repo} / ${file}"
    python3 - "$repo" <<'PY' || true
import json, sys, urllib.request
repo = sys.argv[1]
try:
    with urllib.request.urlopen(f"https://huggingface.co/api/models/{repo}", timeout=30) as r:
        data = json.load(r)
except Exception as e:
    print(f"  HF API: {e}")
    sys.exit(0)
print(f"  lastModified: {data.get('lastModified')}")
print(f"  repo sha:     {data.get('sha')}")
PY

    if [[ -f "$path" ]]; then
        local got
        got=$(sha256sum "$path" | awk '{print $1}')
        if [[ "$got" == "$expected" ]]; then
            echo "  local OK  ${got}"
            return 0
        fi
        echo "  SHA-256 mismatch, re-downloading…"
        echo "    expected ${expected}"
        echo "    local    ${got}"
    else
        echo "  missing, downloading…"
    fi

    command -v hf >/dev/null 2>&1 || {
        echo "hf not found. Install: pip install -U huggingface_hub" >&2
        exit 1
    }
    hf download "$repo" "$file" --local-dir models
    local got
    got=$(sha256sum "$path" | awk '{print $1}')
    if [[ "$got" != "$expected" ]]; then
        echo "SHA-256 still wrong after download:" >&2
        echo "  expected ${expected}" >&2
        echo "  got      ${got}" >&2
        exit 1
    fi
    echo "  OK  ${got}"
}

do_download() {
    mkdir -p models
    local m
    for m in "${BEE_MODELS[@]}"; do
        check_one "${m}.yml"
    done
    echo
    echo "Done. models/ is ready."
}

cmd="${1:-}"
case "$cmd" in
    stop)
        down_all
        echo "Stopped."
        docker compose ls
        nvidia-smi --query-gpu=name,memory.used,memory.total,memory.free --format=csv
        ;;
    build)    do_build "${2:-bee}" ;;
    download) do_download ;;
    ""|-h|--help) usage ;;
    *)
        if [[ -f "${cmd}.yml" ]]; then
            up_model "${cmd}.yml"
        else
            usage
        fi
        ;;
esac
